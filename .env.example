# Copy to .env. Never commit .env.
DATABASE_URL=postgresql://bom_app:your_password@localhost:5432/robotics_bom
# TEST_DATABASE_URL=postgresql://bom_app:your_password@localhost:5432/robotics_bom_test

APIFY_TOKEN=
APIFY_API_TOKEN=your_token
APIFY_PRODUCT_MONITOR_ACTOR_ID=your_actor_id
APIFY_WEBHOOK_SECRET=your_random_webhook_secret
APIFY_WEBHOOK_BASE_URL=https://your-app.example.com
APIFY_DEFAULT_BUILD=latest
APIFY_MAX_RUN_COST_USD=1.00
APPROVED_PRODUCT_DOMAINS=example.com
APIFY_API_BASE_URL=https://api.apify.com/v2

# Product discovery: Elastic Cloud or local Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Project-local Elasticsearch helper (optional)
ES_URL=http://localhost:9200
ES_API_KEY=
# Or use basic auth instead of ES_API_KEY:
ES_USERNAME=
ES_PASSWORD=

# Keep writes disabled by default. Enable for one intentional command only.
ES_ALLOW_WRITES=0
